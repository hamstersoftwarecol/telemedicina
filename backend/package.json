{
  "name": "telemedicina-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply telemedicina-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply telemedicina-db",
    "db:seed": "wrangler d1 execute telemedicina-db --local --file=./db/seed.sql",
    "db:seed:prod": "wrangler d1 execute telemedicina-db --file=./db/seed.sql",
    "types": "wrangler types"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@hono/zod-validator": "^0.4.1",
    "@noble/hashes": "^1.5.0",
    "hono": "^4.6.20",
    "jose": "^5.9.6",
    "stripe": "^22.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.94.0"
  }
}
