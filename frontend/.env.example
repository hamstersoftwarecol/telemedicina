# Frontend environment variables
# Copy to .env.local for local dev: cp .env.example .env.local

# For development, the Vite proxy sends /api to localhost:8787
# In production (Cloudflare Pages), leave empty so it routes to the worker
VITE_API_URL=http://localhost:8787/api

# Cloudflare Turnstile site key
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_YOUR_TURNSTILE_KEY

# App
VITE_APP_NAME=TelemedApp
VITE_APP_VERSION=1.0.0
